# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Zoho Catalyst QuickML Configuration (Optional in Demo Mode, Required for Production)
ZOHO_QUICKML_ENDPOINT="https://quickml.catalyst.zoho.com/baas/v1/project/{project_id}/ml/models/{model_id}/predict"
ZOHO_CATALYST_API_KEY="MY_CATALYST_AUTH_TOKEN"
ZOHO_PROJECT_ID="MY_CATALYST_PROJECT_ID"
ZOHO_CATALYST_ENV="development"
ZOHO_QUICKML_TIMEOUT_MS=8000
